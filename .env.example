# Copier en .env (ignoré par git). C'est Simon qui saisit les vraies valeurs.
# En production : variables d'environnement Netlify, jamais dans le repo.

# Projet Supabase HVAC (compte perso de Simon, région ca-central-1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service_role : fonctions serverless seulement (tâches système). Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Adapter de données actif : supabase (monday et friday sont des stubs)
DATA_ADAPTER=supabase

# Intégrations prêtes mais désactivées (CLAUDE.md §5)
MONDAY_ENABLED=false
FRIDAY_SYNC_ENABLED=false
MONDAY_WEBHOOK_SECRET=

# Version des scripts (?v=), même principe que chez Mike
APP_VERSION=0.2.0
